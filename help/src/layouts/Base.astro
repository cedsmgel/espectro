---
import '../styles/global.css';
import { APP_URL } from '../categorias';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo, descricao = 'Respostas rápidas sobre conta, privacidade, mensagens, segurança e seus dados no Espectro.' } = Astro.props;
const titleFull = titulo ? `${titulo} · Ajuda do Espectro` : 'Ajuda do Espectro';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ano = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleFull}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0a" />
    {/* Em preparação: remover no lançamento */}
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={titleFull} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <script is:inline src="/theme.js"></script>
    <script is:inline src="/toggle-theme.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="Ajuda do Espectro, página inicial">
          <span class="brand-mark" aria-hidden="true">E</span>
          <span>Espectro <span class="brand-sub">Ajuda</span></span>
        </a>
        <div class="header-actions">
          <a class="btn-link" href="/contato">Contato</a>
          <a class="btn-link" href={APP_URL}>Voltar ao Espectro</a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Alternar tema claro e escuro" aria-pressed="false">
            <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
            <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="conteudo">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>Espectro © {ano}</span>
        <nav class="footer-links" aria-label="Rodapé">
          <a href="/categoria/termos-e-politicas">Termos e políticas</a>
          <a href="/contato">Contato</a>
          <a href={APP_URL}>Voltar ao Espectro</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
