---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categorias } from '../../categorias';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos');
  return artigos.map((artigo) => ({ params: { id: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
const categoria = categorias.find((c) => c.slug === artigo.data.categoria)!;
const atualizado = artigo.data.atualizado.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base titulo={artigo.data.titulo} descricao={artigo.data.resumo}>
  <article class="article">
    <nav class="crumbs" aria-label="Você está em">
      <a href="/">Ajuda</a> › <a href={`/categoria/${categoria.slug}`}>{categoria.nome}</a>
    </nav>
    <h1>{artigo.data.titulo}</h1>
    <p class="meta">Atualizado em {atualizado}</p>
    <div class="prose"><Content /></div>
    <p class="callout">Não encontrou o que procurava? <a href="/contato">Fale com o suporte</a>.</p>
  </article>
</Base>
