{
  "name": "espectro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:chat": "tsc --noEmit -p chat-worker/tsconfig.json",
    "deploy:chat": "npm --prefix chat-worker run deploy",
    "db:migrate:local": "wrangler d1 migrations apply espectro --local",
    "db:migrate:remote": "wrangler d1 migrations apply espectro --remote"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "axios": "^1.21.0",
    "compressorjs": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.4",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
